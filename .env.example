# Copy to .env and fill in. .env is gitignored — never commit real values.

# --- ElevenLabs (expressive TTS "mouth") ---
# API KEY (Developers -> API Keys, starts with sk_) — NOT the promo/coupon code.
ELEVENLABS_API_KEY=
# Pick a warm premade voice (e.g. Sarah = EXAVITQu4vr4xnSDxMaL) or a Voice Design id.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
# multilingual_v2 = most natural; flash_v2_5 = faster but flatter.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# --- GPU inference server (our /analyze + /answer service; see CLAUDE.local.md) ---
EMOTION_SERVER_URL=http://HOST:8100
INFERENCE_AUTH_TOKEN=

# --- Used BY the server service (set on the box, not the Mac) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
SEARXNG_URL=http://127.0.0.1:8080
EMOTION_CUDA_DEVICE=1            # pin emotion model to the spare GPU (use CUDA_VISIBLE_DEVICES=1)
EMOTION_MODEL=emotion2vec/emotion2vec_plus_large
EMOTION_HUB=hf                  # hf (HuggingFace, fast) | ms (ModelScope, slow from US)

# --- Data layer: OUR OWN containers on the box (NOT CityPulse's 5432/5433/6379) ---
LUMI_PG_DSN=postgresql://lumi:CHANGEME@127.0.0.1:5434/lumi
LUMI_REDIS_URL=redis://127.0.0.1:6380/0
LUMI_AUTH_SECRET=                # HMAC secret for signing guest device tokens

# --- Local fallback (laptop-only mode if the server/network is down) ---
ALLOW_LOCAL_FALLBACK=true
